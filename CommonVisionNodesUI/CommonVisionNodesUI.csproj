<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop;net10.0-browserwasm;net10.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <UnoSingleProject>true</UnoSingleProject>
    <UnoDisableHotDesign>true</UnoDisableHotDesign>

    <ApplicationTitle>CommonVisionNodesUI</ApplicationTitle>
    <ApplicationId>com.companyname.CommonVisionNodesUI</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationPublisher>timst</ApplicationPublisher>
    <Description>CommonVisionNodesUI powered by Uno Platform.</Description>

    <UnoFeatures>
      Material;
      Hosting;
      Toolkit;
      Logging;
      Mvvm;
      Configuration;
      Localization;
      ThemeService;
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cvb.Uno.Toolkit\Cvb.Uno.Toolkit.csproj" />
    <ProjectReference Include="..\CommonVisionNodes.Contracts\CommonVisionNodes.Contracts.csproj" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)'=='net10.0-browserwasm'">
    <PublishTrimmed>false</PublishTrimmed>
    <WasmShellIndexHtmlPath>$(MSBuildProjectDirectory)\Platforms\WebAssembly\index.html</WasmShellIndexHtmlPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)'=='net10.0-browserwasm' and '$(Configuration)'=='Release'">
    <!-- Partial trimming removes unused assemblies while keeping the actively used framework surface intact. -->
    <!-- Uno evaluates implicit package conditions before the SDK supplies this Release default. -->
    <Optimize>true</Optimize>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <!--
    Uno 6.6 auto-adds the desktop-oriented Microsoft.Windows.Compatibility bundle to every
    executable WebAssembly project. It brings WCF, SqlClient, MEF, and reflection assemblies
    that this browser UI does not use, and that are not trim-safe. Remove only that browser
    restore item from Uno's implicit-package inputs before its resolver runs.
  -->
  <Target Name="ExcludeBrowserWasmWindowsCompatibility"
          BeforeTargets="UnoImplicitPackages"
          Condition="'$(TargetFramework)' == 'net10.0-browserwasm'">
    <ItemGroup>
      <_UnoProjectSystemPackageReference Remove="Microsoft.Windows.Compatibility" />
    </ItemGroup>
  </Target>

  <!-- The SDK evaluates these design-time packages before multi-targeted Release defaults apply. -->
  <Target Name="ExcludeBrowserWasmReleaseDevelopmentPackages"
          BeforeTargets="UnoImplicitPackages"
          Condition="'$(TargetFramework)' == 'net10.0-browserwasm' and '$(Configuration)' == 'Release'">
    <ItemGroup>
      <_UnoProjectSystemPackageReference Remove="Uno.UI.App.Mcp;Uno.WinUI.DevServer" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Page Update="Controls\NodeControl.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Controls\CropImageDisplay.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Controls\HistogramDisplay.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Controls\BlobImageDisplay.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Controls\CodeReaderImageDisplay.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Controls\GenericVisualizerDisplay.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Controls\PolimagoImageDisplay.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <Target Name="PatchUnoBootstrapForBrowserWasm" AfterTargets="Build" Condition="'$(TargetFramework)' == 'net10.0-browserwasm'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Platforms\WebAssembly\Patch-UnoBootstrap.ps1&quot; &quot;$(OutputPath)wwwroot&quot;" />
  </Target>

  <!--
    The .NET WebAssembly publish pipeline keeps a second WebCIL cache below
    webcil\publish. Package upgrades do not always invalidate that cache, which
    can mix current Uno JavaScript with older managed exports at runtime.
  -->
  <Target Name="ClearBrowserWasmPublishWebCilCache"
          BeforeTargets="ProcessPublishFilesForWasm"
          Condition="'$(TargetFramework)' == 'net10.0-browserwasm'">
    <RemoveDir Directories="$(IntermediateOutputPath)webcil\publish;$(IntermediateOutputPath)tmp-webcil\publish" />
  </Target>

  <!--
    Compression output is derived from the post-link asset set. Remove the previous publish
    cache before static-web-asset resolution so a trimmed publish cannot reuse sidecars for
    assemblies that were removed or renamed by the linker.
  -->
  <Target Name="ClearBrowserWasmPublishCompressionCache"
          BeforeTargets="ResolvePublishCompressedStaticWebAssetsConfiguration"
          Condition="'$(TargetFramework)' == 'net10.0-browserwasm'">
    <RemoveDir Directories="$(IntermediateOutputPath)compressed\publish" />
  </Target>
</Project>
