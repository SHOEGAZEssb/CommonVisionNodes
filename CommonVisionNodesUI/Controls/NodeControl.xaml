<UserControl
    x:Class="CommonVisionNodesUI.Controls.NodeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cvb="using:Cvb.Uno.Toolkit.Controls"
    xmlns:local="using:CommonVisionNodesUI.Controls">

    <Border x:Name="NodeBorder" CornerRadius="8"
            BorderBrush="#555555" BorderThickness="1"
            Background="#2D2D2D"
            MinWidth="160"
            MinHeight="104">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header (drag handle) -->
            <Border x:Name="HeaderBorder" Grid.Row="0"
                    Height="36"
                    CornerRadius="7,7,0,0" Padding="12,0"
                    PointerPressed="Header_PointerPressed"
                    PointerMoved="Header_PointerMoved"
                    PointerReleased="Header_PointerReleased">
                <TextBlock x:Name="TitleText"
                           VerticalAlignment="Center"
                           Foreground="White" FontWeight="SemiBold" FontSize="13"/>
            </Border>

            <!-- Ports -->
            <Grid Grid.Row="1" Padding="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Input Ports -->
                <ItemsControl x:Name="InputPortsList" Grid.Column="0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Height="28" Padding="4,0">
                                <ToolTipService.ToolTip>
                                    <ToolTip Content="{Binding Tooltip}" Opened="PortToolTip_Opened"/>
                                </ToolTipService.ToolTip>
                                <Ellipse Width="12" Height="12" Fill="#4FC3F7"
                                         VerticalAlignment="Center"
                                         PointerPressed="Port_PointerPressed"/>
                                <TextBlock Text="{Binding Port.Name}" Margin="6,0,0,0"
                                           VerticalAlignment="Center" FontSize="12"
                                           Foreground="#CCCCCC"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Output Ports -->
                <ItemsControl x:Name="OutputPortsList" Grid.Column="1">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Height="28" Padding="4,0">
                                <ToolTipService.ToolTip>
                                    <ToolTip Content="{Binding Tooltip}" Opened="PortToolTip_Opened"/>
                                </ToolTipService.ToolTip>
                                <TextBlock Text="{Binding Port.Name}" Margin="0,0,6,0"
                                           VerticalAlignment="Center" FontSize="12"
                                           Foreground="#CCCCCC"/>
                                <Ellipse Width="12" Height="12" Fill="#FFB74D"
                                         VerticalAlignment="Center"
                                         PointerPressed="Port_PointerPressed"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- Execution error -->
            <Border x:Name="ExecutionErrorPanel" Grid.Row="2"
                    Visibility="Collapsed"
                    Background="#3A1717"
                    BorderBrush="#D32F2F"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="6,0,6,6"
                    Padding="6,4">
                <TextBlock x:Name="ExecutionErrorText"
                           FontSize="11"
                           Foreground="#FFCDD2"
                           TextWrapping="WrapWholeWords"
                           TextTrimming="CharacterEllipsis"/>
            </Border>

            <!-- Summary / custom content -->
            <TextBlock x:Name="SummaryText" Grid.Row="3"
                       Visibility="Collapsed"
                       FontSize="11" Foreground="#999999"
                       TextTrimming="CharacterEllipsis"
                       Padding="8,0,8,6"/>

            <!-- Execution metrics -->
            <StackPanel x:Name="ExecutionMetricsPanel" Grid.Row="3"
                        Visibility="Collapsed"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Padding="8,0,8,6">
                <TextBlock x:Name="ExecutionTimeText"
                           FontSize="10" Foreground="#777777"/>
                <TextBlock x:Name="SinkFpsText"
                           FontSize="10" Foreground="#777777"
                           Margin="8,0,0,0"/>
            </StackPanel>
        
            <!-- Image preview -->
            <cvb:CvbImageDisplay x:Name="ImagePreview" Grid.Row="4"
                                 Margin="4,0,4,4"
                                 Visibility="Collapsed"/>

            <!-- Crop image preview (SubImage node) -->
            <local:CropImageDisplay x:Name="CropPreview" Grid.Row="4"
                                    Margin="4,0,4,4"
                                    Visibility="Collapsed"/>

            <!-- Histogram preview -->
            <local:HistogramDisplay x:Name="HistogramPreview" Grid.Row="4"
                                    Margin="4,0,4,4"
                                    Visibility="Collapsed"/>

            <!-- Blob image preview with bounding boxes -->
            <local:BlobImageDisplay x:Name="BlobPreview" Grid.Row="4"
                                    Margin="4,0,4,4"
                                    Visibility="Collapsed"/>

            <!-- Pattern recognition preview with result overlays -->
            <local:PolimagoImageDisplay x:Name="PolimagoPreview" Grid.Row="4"
                                        Margin="4,0,4,4"
                                        Visibility="Collapsed"/>

            <!-- CodeReader preview with decoded code corner overlays -->
            <local:CodeReaderImageDisplay x:Name="CodeReaderPreview" Grid.Row="4"
                                          Margin="4,0,4,4"
                                          Visibility="Collapsed"/>

            <!-- Generic visualizer preview -->
            <local:GenericVisualizerDisplay x:Name="GenericVisualizerPreview" Grid.Row="4"
                                            Margin="4,0,4,4"
                                            Visibility="Collapsed"/>

            <Border x:Name="ResizeGrip"
                    Grid.RowSpan="5"
                    Canvas.ZIndex="100"
                    Width="18"
                    Height="18"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="#01000000"
                    Visibility="Collapsed"
                    PointerPressed="ResizeGrip_PointerPressed"
                    PointerMoved="ResizeGrip_PointerMoved"
                    PointerReleased="ResizeGrip_PointerReleased"
                    ToolTipService.ToolTip="Resize node">
                <Path Data="M 4 14 L 14 4 M 8 14 L 14 8 M 12 14 L 14 12"
                      Stroke="#888888"
                      StrokeThickness="1.4"
                      Stretch="None"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsHitTestVisible="False"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
