<UserControl
    x:Class="Cvb.Uno.Toolkit.Controls.CvbImageDisplay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Cvb.Uno.Toolkit.Controls">

    <Grid Background="#1A1A1A" CornerRadius="4">
        <local:PreviewImagePresenter x:Name="DisplayImage"/>

        <TextBlock x:Name="PlaceholderText"
                   Text="No image"
                   Foreground="#555555" FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <Border x:Name="InfoOverlay"
                VerticalAlignment="Bottom" HorizontalAlignment="Left"
                Background="#AA000000" CornerRadius="0,4,0,4"
                Padding="6,2" Visibility="Collapsed">
            <TextBlock x:Name="InfoText" FontSize="10" Foreground="#CCCCCC"/>
        </Border>
    </Grid>
</UserControl>
